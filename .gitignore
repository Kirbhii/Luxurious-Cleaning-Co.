# This project uses npm (package-lock.json). Do not add a pnpm lockfile —
# Vercel auto-detects pnpm-lock.yaml and switches to `pnpm install`,
# which then fails the build.
pnpm-lock.yaml
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*
/.figma/design-context/

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/
